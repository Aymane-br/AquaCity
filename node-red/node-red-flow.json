 {
  "id": "fnAI",
  "type": "function",
  "z": "flow",
  "name": "top label",
  "func": "// Pick the class with the highest score\nconst p = msg.payload || {};\nlet label = p.label, conf = p.confidence;\nif (!label && p.predictions) {\n  for (const [k, v] of Object.entries(p.predictions)) {\n    if (conf === undefined || v > conf) { label = k; conf = v; }\n  }\n}\nif (!label) return null;\nreturn [{ payload: label }, { payload: Math.round(conf * 100) + ' %' }];",
  "outputs": 2,
  "x": 400,
  "y": 800,
  "wires": [
   [
    "tL",
    "fwd"
   ],
   [
    "tC"
   ]
  ]
 },
 {
  "id": "fwd",
  "type": "function",
  "z": "flow",
  "name": "green/yellow only",
  "func": "const l = String(msg.payload).toLowerCase();\nif (l !== 'green' && l !== 'yellow') return null;\nreturn { payload: l };",
  "outputs": 1,
  "x": 600,
  "y": 830,
  "wires": [
   [
    "outLeaf"
   ]
  ]
 },
